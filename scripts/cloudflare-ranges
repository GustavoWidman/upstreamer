#!/usr/bin/env bash
# Regenerates src/trust/cloudflare.rs, the `cloudflare` preset of `trustedProxies`, from the
# ranges Cloudflare publishes at https://www.cloudflare.com/ips/.
#
#   scripts/cloudflare-ranges            rewrite the file
#   scripts/cloudflare-ranges --check    exit 1 when the file differs from the published ranges
#
# Cloudflare changes the list rarely; run this before a release and commit the result.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
target="$root/src/trust/cloudflare.rs"
mode=${1:-write}
case "$mode" in write | --check) ;; *)
	echo "usage: $0 [--check]" >&2
	exit 2
	;;
esac

fetch() {
	curl --fail --silent --show-error --location --max-time 30 "https://www.cloudflare.com/$1" | tr -d '\r'
}

# One range per line, nothing else, and at least a few of them: a changed page must not
# silently become an empty or wrong preset.
validate() {
	local family=$1 pattern=$2 min=$3 lines
	lines=$(cat)
	if [ -z "$lines" ] || printf '%s\n' "$lines" | grep -qvE "$pattern"; then
		echo "cloudflare-ranges: unexpected content in $family list" >&2
		exit 1
	fi
	if [ "$(printf '%s\n' "$lines" | wc -l)" -lt "$min" ]; then
		echo "cloudflare-ranges: fewer than $min $family ranges" >&2
		exit 1
	fi
	printf '%s\n' "$lines"
}

emit() {
	printf '    "%s",\n' $(cat)
}

v4=$(fetch ips-v4 | validate IPv4 '^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$' 5)
v6=$(fetch ips-v6 | validate IPv6 '^[0-9a-f:]+/[0-9]{1,3}$' 3)

generated=$(
	cat <<HEADER
//! The ranges Cloudflare publishes at <https://www.cloudflare.com/ips/>. Generated by
//! \`scripts/cloudflare-ranges\`; edit nothing here.

pub(super) const IPV4: &[&str] = &[
$(printf '%s\n' "$v4" | emit)
];

pub(super) const IPV6: &[&str] = &[
$(printf '%s\n' "$v6" | emit)
];
HEADER
)

if [ "$mode" = "--check" ]; then
	if [ "$generated" != "$(cat "$target")" ]; then
		echo "cloudflare-ranges: $target is out of date; run scripts/cloudflare-ranges" >&2
		exit 1
	fi
	exit 0
fi
printf '%s\n' "$generated" >"$target"
