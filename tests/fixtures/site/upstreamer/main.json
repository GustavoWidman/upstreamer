{
  "fragment": 1,
  "headers": {
    "Server": null,
    "Last-Modified": null,
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Cross-Origin-Opener-Policy": "same-origin"
  },
  "routes": [
    { "name": "no_ims", "requestHeaders": { "If-Modified-Since": null } },
    { "name": "encode", "encode": ["zstd", "gzip"] },

    { "name": "release", "set": { "release": "r1" } },
    { "name": "release_r2", "when": { "after": 1893456000 }, "set": { "release": "r2" } },

    { "name": "lang_default", "set": { "lang": "en" } },
    {
      "name": "lang_accept",
      "when": { "value": "{header.Accept-Language}", "regex": "(?i)^\\s*de([-_;,\\s]|$)" },
      "set": { "lang": "de" }
    },
    {
      "name": "lang_cookie",
      "when": { "value": "{cookie.site_lang}", "in": ["en", "de"] },
      "set": { "lang": "{cookie.site_lang}" }
    },
    {
      "name": "lang_query",
      "when": { "value": "{query.lang}", "in": ["en", "de"] },
      "set": { "lang": "{query.lang}" }
    },

    { "name": "tree", "set": { "tree": "@out@/pages/{vars.release}/main/{vars.lang}" } },

    {
      "name": "plain_wanted",
      "when": {
        "any": [
          { "query": { "format": ["text", "markdown"] } },
          { "headerRegex": { "Accept": "(?i)^text/(markdown|plain)" } },
          {
            "headerRegex": { "Accept": "(?i)text/(markdown|plain)" },
            "none": [{ "headerRegex": { "Accept": "[*]/[*]" } }]
          },
          { "headerRegex": { "User-Agent": "(?i)(examplebot|fetcher)" } }
        ]
      },
      "set": { "plain": "yes" }
    },

    { "name": "unsafe_path", "when": { "pathRegex": "[\\\\\\x00-\\x1f\\x7f]" }, "error": 404 },

    {
      "name": "trailing_slash",
      "when": { "pathRegex": "^/(.+)/$" },
      "redirect": { "to": "/{re.1}{?query}", "status": 301 }
    },
    {
      "name": "index_html",
      "when": { "pathRegex": "^/(?:(.*)/)?index\\.html$" },
      "redirect": { "to": "/{re.1}{?query}", "status": 301 }
    },

    {
      "name": "internal",
      "when": { "path": ["/_text", "/_text/*", "/404.html", "*.etag", "*.br", "*.zst", "*.gz"] },
      "error": 404
    },

    {
      "name": "assets",
      "when": { "path": "/_assets/*" },
      "routes": [
        { "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
        { "files": { "root": "@out@", "precompressed": ["br", "zstd", "gzip"] } }
      ]
    },

    {
      "name": "static",
      "when": {
        "none": [{ "path": "/" }],
        "file": { "root": "@out@/static", "paths": ["{path}"] }
      },
      "routes": [
        { "headers": { "Cache-Control": "public, max-age=3600" } },
        { "when": { "path": "*.txt" }, "headers": { "Content-Type": "text/plain; charset=utf-8" } },
        { "files": { "root": "@out@/static", "precompressed": ["br", "zstd", "gzip"], "etagSidecar": ".etag" } }
      ]
    },

    { "name": "page_caching", "headers": { "Cache-Control": "private, no-cache", "Vary": "Cookie, Accept-Language" } },

    {
      "name": "rewrites",
      "firstOf": [
        {
          "name": "text_page",
          "when": { "value": "{vars.plain}", "in": ["yes"], "pathRegex": "^/docs/([^/.]+)$" },
          "rewrite": "/_text/docs/{re.1}.md"
        },
        {
          "name": "text_suffix",
          "when": { "pathRegex": "^/docs/([^/]+)\\.md$" },
          "rewrite": "/_text/docs/{re.1}.md"
        },
        {
          "name": "curl",
          "when": { "path": ["/", "/index"], "header": { "User-Agent": "curl/*" } },
          "rewrite": "/_text/index.txt"
        },
        {
          "name": "try_files",
          "tryFiles": { "root": "{vars.tree}", "paths": ["{path}/index.html", "{path}"] }
        }
      ]
    },

    { "when": { "path": "*.html" }, "headers": { "Content-Type": "text/html; charset=utf-8" } },
    { "when": { "path": "*.md" }, "headers": { "Content-Type": "text/markdown; charset=utf-8" } },
    { "when": { "path": "/feed.xml" }, "headers": { "Content-Type": "application/rss+xml; charset=utf-8" } },

    {
      "name": "serve_tree",
      "files": { "root": "{vars.tree}", "precompressed": ["br", "zstd", "gzip"], "etagSidecar": ".etag" }
    }
  ],
  "errors": [
    {
      "status": [404],
      "routes": [
        { "rewrite": "/404.html" },
        { "headers": { "Cache-Control": "private, no-cache", "Content-Type": "text/html; charset=utf-8" } },
        { "encode": ["zstd", "gzip"] },
        { "files": { "root": "{vars.tree}", "precompressed": ["br", "zstd", "gzip"] } }
      ]
    },
    {
      "routes": [
        { "headers": { "Cache-Control": "no-store" } },
        { "respond": { "body": "{err.status_code} {err.status_text}" } }
      ]
    }
  ]
}
