{
  "config": "portfolio/config.json",
  "out": "portfolio/out",
  "cases": [
    {
      "name": "home page",
      "request": "GET https://example.org/",
      "outcome": "files @out@/site/e0/main/en",
      "path": "/index.html",
      "vars": {
        "epoch": "e0",
        "lang": "en",
        "tree": "@out@/site/e0/main/en",
        "markdown": null
      },
      "ops": [
        [
          "Cache-Control",
          "private, no-cache"
        ],
        [
          "Vary",
          "Cookie, Accept-Language"
        ],
        [
          "Vary",
          "Cookie, Accept-Language, User-Agent, Accept"
        ],
        [
          "Content-Type",
          "text/html; charset=utf-8"
        ]
      ],
      "encode": [
        "zstd",
        "gzip"
      ]
    },
    {
      "name": "Accept-Language pt picks the pt tree",
      "request": "GET https://example.org/",
      "headers": [
        [
          "Accept-Language",
          "pt-BR,pt;q=0.9,en;q=0.8"
        ]
      ],
      "outcome": "files @out@/site/e0/main/pt",
      "path": "/index.html",
      "vars": {
        "epoch": "e0",
        "lang": "pt",
        "tree": "@out@/site/e0/main/pt",
        "markdown": null
      }
    },
    {
      "name": "only the first Accept-Language tag counts",
      "request": "GET https://example.org/",
      "headers": [
        [
          "Accept-Language",
          "en-US, pt"
        ]
      ],
      "outcome": "files @out@/site/e0/main/en",
      "vars": {
        "epoch": "e0",
        "lang": "en",
        "tree": "@out@/site/e0/main/en",
        "markdown": null
      }
    },
    {
      "name": "Accept-Language is matched case-insensitively after spaces",
      "request": "GET https://example.org/",
      "headers": [
        [
          "Accept-Language",
          "  PT"
        ]
      ],
      "outcome": "files @out@/site/e0/main/pt",
      "vars": {
        "epoch": "e0",
        "lang": "pt",
        "tree": "@out@/site/e0/main/pt",
        "markdown": null
      }
    },
    {
      "name": "a tag that only starts with pt is not pt",
      "request": "GET https://example.org/",
      "headers": [
        [
          "Accept-Language",
          "ptx"
        ]
      ],
      "outcome": "files @out@/site/e0/main/en",
      "vars": {
        "epoch": "e0",
        "lang": "en",
        "tree": "@out@/site/e0/main/en",
        "markdown": null
      }
    },
    {
      "name": "Accept-Language with a q-value",
      "request": "GET https://example.org/",
      "headers": [
        [
          "Accept-Language",
          "pt;q=0.9"
        ]
      ],
      "outcome": "files @out@/site/e0/main/pt",
      "vars": {
        "epoch": "e0",
        "lang": "pt",
        "tree": "@out@/site/e0/main/pt",
        "markdown": null
      }
    },
    {
      "name": "repeated Accept-Language fields are joined, first tag counts",
      "request": "GET https://example.org/",
      "headers": [
        [
          "Accept-Language",
          "en"
        ],
        [
          "Accept-Language",
          "pt"
        ]
      ],
      "outcome": "files @out@/site/e0/main/en",
      "vars": {
        "epoch": "e0",
        "lang": "en",
        "tree": "@out@/site/e0/main/en",
        "markdown": null
      }
    },
    {
      "name": "cookie selects pt",
      "request": "GET https://example.org/",
      "headers": [
        [
          "Cookie",
          "portfolio_lang=pt"
        ]
      ],
      "outcome": "files @out@/site/e0/main/pt",
      "vars": {
        "epoch": "e0",
        "lang": "pt",
        "tree": "@out@/site/e0/main/pt",
        "markdown": null
      }
    },
    {
      "name": "a cookie outside en and pt is ignored",
      "request": "GET https://example.org/",
      "headers": [
        [
          "Cookie",
          "portfolio_lang=fr"
        ]
      ],
      "outcome": "files @out@/site/e0/main/en",
      "vars": {
        "epoch": "e0",
        "lang": "en",
        "tree": "@out@/site/e0/main/en",
        "markdown": null
      }
    },
    {
      "name": "the cookie overrides Accept-Language",
      "request": "GET https://example.org/",
      "headers": [
        [
          "Accept-Language",
          "pt"
        ],
        [
          "Cookie",
          "theme=dark; portfolio_lang=en"
        ]
      ],
      "outcome": "files @out@/site/e0/main/en",
      "vars": {
        "epoch": "e0",
        "lang": "en",
        "tree": "@out@/site/e0/main/en",
        "markdown": null
      }
    },
    {
      "name": "the query overrides the cookie",
      "request": "GET https://example.org/?lang=en",
      "headers": [
        [
          "Cookie",
          "portfolio_lang=pt"
        ]
      ],
      "outcome": "files @out@/site/e0/main/en",
      "vars": {
        "epoch": "e0",
        "lang": "en",
        "tree": "@out@/site/e0/main/en",
        "markdown": null
      }
    },
    {
      "name": "query lang=pt",
      "request": "GET https://example.org/?lang=pt",
      "outcome": "files @out@/site/e0/main/pt",
      "path": "/index.html",
      "vars": {
        "epoch": "e0",
        "lang": "pt",
        "tree": "@out@/site/e0/main/pt",
        "markdown": null
      }
    },
    {
      "name": "query values are case-sensitive",
      "request": "GET https://example.org/?lang=PT",
      "outcome": "files @out@/site/e0/main/en",
      "vars": {
        "epoch": "e0",
        "lang": "en",
        "tree": "@out@/site/e0/main/en",
        "markdown": null
      }
    },
    {
      "name": "www shares the main site",
      "request": "GET https://www.example.org/",
      "outcome": "files @out@/site/e0/main/en",
      "path": "/index.html"
    },
    {
      "name": "the Host is matched without case or port",
      "request": "GET https://EXAMPLE.org:443/",
      "outcome": "files @out@/site/e0/main/en",
      "path": "/index.html"
    },
    {
      "name": "If-Modified-Since never reaches the file server",
      "request": "GET https://example.org/",
      "headers": [
        [
          "If-Modified-Since",
          "Tue, 10 Nov 2026 01:09:53 GMT"
        ]
      ],
      "outcome": "files @out@/site/e0/main/en",
      "requestHeaders": {
        "If-Modified-Since": null,
        "Host": "example.org"
      }
    },
